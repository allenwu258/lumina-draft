{
  "name": "lumina-draft-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format:providers": "prettier --write src/{CallHistory,ModelEditor,ProviderEditor,ProviderSettings,RoutingSettings,SettingsDialog,SettingsNotice}.tsx src/provider-api.ts src/provider-settings.css playwright.config.ts tests/provider-management.spec.ts",
    "format:providers:check": "prettier --check src/{CallHistory,ModelEditor,ProviderEditor,ProviderSettings,RoutingSettings,SettingsDialog,SettingsNotice}.tsx src/provider-api.ts src/provider-settings.css playwright.config.ts tests/provider-management.spec.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.4.1",
    "lucide-react": "0.468.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "prettier": "3.9.10"
  }
}
